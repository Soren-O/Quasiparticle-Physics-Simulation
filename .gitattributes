validation/baselines/**/*.csv text eol=lf
validation/baselines/**/*.json text eol=lf
validation/paper_data/**/*.json text eol=lf
# The paper-data points CSVs and the digitizers that emit them are pinned to
# their LF bytes: the extractor hashes the CSV it holds in memory, before any
# disk write, and oracle.json binds the digitizer's canonical source. A CRLF
# checkout therefore fails the strict re-extraction byte-compare in
# verify_external_source against pins that are correct. Every blob these two
# rules cover is already LF in the index, so they change no committed content
# -- they only stop the working tree from drifting away from it.
validation/paper_data/**/*.csv text eol=lf
validation/fischer_2023/*.py text eol=lf
validation/baselines/legacy/fischer_2024_pre_strict_v2/*.csv -text -eol
validation/baselines/ph0_constant/fischer_fig5_paper.csv -text -eol
validation/baselines/ph0_constant/fischer_figs_9_13_qi_vs_pread.csv -text -eol
