# Byte-compiled / binary
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Build / distribution
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
.env

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
/tmp/

# Validation sweep disk cache (recompute-avoidance; never a reference artifact)
validation/.sweep_cache/
validation/baselines/**/*.lock
.coverage.*
coverage.xml
htmlcov/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Run outputs that validation / scripts may drop. Pinned baseline plots
# under validation/baselines/ are reference artifacts and *are* tracked.
outputs/

# Frontend workspace (setups/runs), if someone points --workspace here
qpsim-workspace/
*.png
*.pdf
!docs/**/*.png
!docs/**/*.pdf
!validation/baselines/**/*.png
!validation/baselines/**/*.pdf
# Paper figures are source artifacts: a fresh clone must build paper.pdf
# without regenerating them (see the paper Makefile's `figures` target).
!papers/qp-diffusion/figures/*.pdf
